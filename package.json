{
    "name": "settlr",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "prisma generate && prisma migrate deploy && next build --turbopack",
        "postinstall": "prisma generate",
        "start": "next start",
        "lint": "eslint",
        "db:reset": "prisma migrate reset --force",
        "db:seed": "tsx --env-file=.env prisma/seed.ts",
        "agent:create": "node --env-file=.env scripts/create-agent.mjs",
        "simulate": "node --env-file=.env scripts/simulate-call.mjs"
    },
    "dependencies": {
        "@prisma/client": "^6.16.2",
        "next": "15.5",
        "qrcode": "^1.5.4",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "15.5",
        "prisma": "^6.16.2",
        "tailwindcss": "^4",
        "tsx": "^4.20.6",
        "typescript": "^5"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
