DATABASE_URL="file:./dev.db"

# Public HTTPS URL of this app (ngrok in dev). Bolna calls the agent tools and webhook here.
PUBLIC_BASE_URL="https://your-id.ngrok-free.app"

# Bolna
BOLNA_API_KEY=""
BOLNA_AGENT_ID=""
# Optional: one of your Bolna numbers. Leave empty to use Bolna's default number.
BOLNA_FROM_NUMBER=""

# Shared secret Bolna sends to our tool endpoints and webhook. Any long random string.
AGENT_TOOL_TOKEN="change-me-to-a-long-random-string"

# Optional: post-call analysis with an LLM. Without it, a rule-based analysis is used.
OPENAI_API_KEY=""

# The payment page is demo-only (no real money) unless UPI_LIVE="true" and UPI_VPA is a UPI ID you own.
UPI_LIVE="false"
UPI_VPA=""

# Optional: send WhatsApp messages through Twilio. The free trial works for demos: use the
# sender number shown under Messaging > Try it out > Send a WhatsApp message.
# Without these, messages stay in the dashboard outbox only.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
# Trial senders only accept fixed templates: set a template's ContentSid (HX...) from the Try it out page.
TWILIO_CONTENT_SID=""
